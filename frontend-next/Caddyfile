# Static file server inside the frontend container. The ingress routes
# everything but /api/* here; TLS, basic auth and noindex all happen in front
# of it.

# Security headers on every response, error pages included (#155). HSTS is not
# here: TLS ends at the cluster's Traefik, which sets it for every host it
# serves (infrastructure: cluster/traefik-config.yaml).
#
# The CSP is as tight as the build allows. Vite emits no inline script or style,
# React's style props go through the CSSOM (which style-src does not govern),
# and the API is same-origin under /api, so 'self' covers scripts, styles and
# fetches. The exceptions: blob: images for document previews, data: SVGs
# that pdf.js uses internally, and the pdf.js worker, which is its own file
# under /assets/. pdf.js gets no wasmUrl, so it needs no 'wasm-unsafe-eval'.
# Two libraries needed help to fit: see public/zod-jitless.js and the
# react-aria <link> in index.html.
# Markdown images from other hosts are blocked on purpose — a note should not
# be able to load a tracking pixel.
(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

:8080 {
	root * /srv
	import security_headers

	# The app spent its preview under /next/ (#122). Password-reset mails sent
	# then, bookmarks and the preview's installed app still point there, so the
	# prefix redirects to the same page at the root. The fragment (a reset
	# token) is not sent to the server; the browser carries it across.
	redir /next /
	@preview path_regexp preview ^/next(/.*)$
	redir @preview {re.preview.1}{?query}

	# Vite puts a content hash in every filename under assets/, so a changed
	# file is a new URL and these can be cached for good. No SPA fallback here:
	# a chunk from an older build that no longer exists must be a 404, not
	# index.html served as JavaScript.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html, config.json, manifest.json and version.json keep their names
	# across builds, so they always revalidate: without an explicit
	# Cache-Control the browser falls back to heuristic freshness and keeps
	# serving an old index.html from disk, even across a normal reload.
	# Unknown paths fall back to index.html so deep links survive a reload.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# A missing asset must not inherit the year-long header above. During a
	# rolling update the new index.html can ask the old pod for a chunk it does
	# not have yet; cached as immutable, that 404 would outlive the rollout.
	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}"
	}
}
