{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:openssf-scorecard",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "semanticCommits": "enabled",
  "minimumReleaseAge": "2 days",
  "internalChecksFilter": "strict",
  "pinDigests": true,
  "osvVulnerabilityAlerts": true,
  "configMigration": true,
  "dependencyDashboard": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in workflow env, marked with a `# renovate:` comment on the line above (TRIVY_VERSION in ci.yml).",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+:\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Never group unrelated packages into one PR - each update stays individually reviewable.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": null
    },
    {
      "description": "Majors get a longer cooldown and explicit dashboard approval before a branch is even created.",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Digest-only updates of already-pinned images carry no new version, so the age gate does not apply.",
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Base images ship inside the release images, so updating them is a fix(deps): it cuts a patch release instead of waiting for the next feat or fix.",
      "matchFileNames": [
        "backend/Dockerfile",
        "frontend-next/Dockerfile",
        "backup/Dockerfile"
      ],
      "semanticCommitType": "fix"
    },
    {
      "description": "Backend runtime dependencies ship in the image too. Dev dependency groups stay chore(deps). npm `dependencies` in frontend-next/ already get fix from config:recommended.",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "project.dependencies"
      ],
      "semanticCommitType": "fix"
    }
  ]
}