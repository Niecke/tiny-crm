# development (default) warns about the placeholder values below;
# production refuses to start on them.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm
JWT_SECRET=replace-with-openssl-rand-hex-32

# Any origin is allowed by default. In production set the frontend's real origin:
# CORS_ORIGINS=["https://crm.example.com"]

S3_ENDPOINT_URL=http://localhost:9000
# Defaults are the MinIO demo credentials — replace for any real deployment.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Set to true to log every SQL statement incl. its parameters (dev only)
DB_ECHO=false
